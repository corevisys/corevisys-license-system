APP_NAME="Corevisys License"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://license.corevisys.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (MySQL / MariaDB on production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=corevisys_license
DB_USERNAME=corevisys_user
DB_PASSWORD=your_strong_db_password_here

# Sessions, Cache & Queue (Database driver recommended unless using Redis)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.corevisys.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Receipt Storage
RECEIPT_DISK=local
RECEIPTS_STORAGE_DISK=local
RECEIPTS_BUCKET=
RECEIPTS_ENDPOINT=
RECEIPTS_URL=
RECEIPT_RETENTION_DAYS=90
RECEIPT_MAX_UPLOAD_SIZE_KB=2048
RECEIPT_ALLOWED_MIME_TYPES=pdf,jpg,png,jpeg
RECEIPT_SCAN_ENDPOINT=
RECEIPT_SCAN_API_KEY=

QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail Configuration (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@corevisys.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend
VITE_APP_NAME="${APP_NAME}"

# Payment Gateways
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=

# Corevisys License Cryptographic Signing (RSA-SHA256)
# Paste base64-encoded or PEM format RSA keys
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=
LICENSE_SIGNING_PUBLIC_KEYS=
LICENSE_SIGNING_KEY_ID=corevisys-key-1
LICENSE_SIGNING_ALGORITHM=RSA-SHA256
LICENSE_ROTATION_OVERLAP_DAYS=30
LICENSE_SIGNING_REVOKED_KEY_IDS=

# License Verification & Pulse Policy
OFFLINE_VALIDITY_DAYS=7
PULSE_INTERVAL_DAYS=30
PULSE_GRACE_DAYS=7
