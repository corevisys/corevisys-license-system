# ============================================================
# CoreVisys License Server — Installer Bootstrap Environment
# ============================================================
# This file is copied to .env automatically during the build
# release process. It is intentionally minimal: it only sets
# values that are required to make the /install wizard work
# on a fresh cPanel deploy (no database or keys yet).
#
# The /install wizard OVERWRITES this file with a fully
# configured .env once you complete the setup form.
# DO NOT edit this file manually. Edit .env after installing.
# ============================================================

APP_NAME="Corevisys License"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://license.corevisys.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=corevisys_license
DB_USERNAME=corevisys_user
DB_PASSWORD=

# CRITICAL: Use file driver BEFORE database is set up.
# The /install wizard will change these to 'database' after migration.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@corevisys.com"
MAIL_FROM_NAME="Corevisys License"

LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=
LICENSE_SIGNING_PUBLIC_KEYS=
LICENSE_SIGNING_KEY_ID=
LICENSE_SIGNING_ALGORITHM=RSA-SHA256
LICENSE_PEPPER=

OFFLINE_VALIDITY_DAYS=7
PULSE_INTERVAL_DAYS=30
PULSE_GRACE_DAYS=7

TRUSTED_PROXIES=*
