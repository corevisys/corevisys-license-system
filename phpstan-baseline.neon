parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$value of method Carbon\\Carbon\:\:subDays\(\) expects float\|int, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: app/Console/Commands/CleanupExpiredLicenses.php

		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 1
			path: app/Console/Commands/GenerateLicenseKeysCommand.php

		-
			message: '#^Dead catch \- Throwable is never thrown in the try block\.$#'
			identifier: catch.neverThrown
			count: 1
			path: app/Console/Commands/MigrateLegacyLicenseKeys.php

		-
			message: '#^Access to an undefined property App\\Models\\Order\:\:\$items\.$#'
			identifier: property.notFound
			count: 1
